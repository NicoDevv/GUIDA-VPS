# Configurazione emulatore Android VPS
# Modifica questi valori prima di eseguire gli script

AVD_NAME="VPS_Device"
API_LEVEL="33"
RAM_MB="2048"
STORAGE_GB="12"
SPOOF_DEVICE="Pixel 6"

# Android SDK - non modificare se non sai cosa fai
ANDROID_HOME="$HOME/android-sdk"
CMDLINE_TOOLS_VERSION="11076708"
CMDLINE_TOOLS_URL="https://dl.google.com/android/repository/commandlinetools-linux-${CMDLINE_TOOLS_VERSION}_latest.zip"

# rootAVD
ROOTAVD_REPO="https://gitlab.com/newbit/rootAVD.git"
ROOTAVD_DIR="$HOME/rootAVD"

# HideMagiskSpoof
SPOOF_MODULE_URL="https://github.com/Magisk-Modules-Repo/MagiskHidePropsConf/releases/download/v6.1.2/MagiskHidePropsConf-v6.1.2.zip"
SPOOF_MODULE_ZIP="MagiskHidePropsConf-v6.1.2.zip"

# Display virtuale per Xvfb
DISPLAY_NUM=":99"
